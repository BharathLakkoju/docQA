# WorkflowGPT / CI-CD Copilot — environment variables
# Copy to .env and fill in real values. Never commit .env.

# --- Vector DB (Pinecone) ---
# Free-tier serverless index. Create at https://app.pinecone.io
PINECONE_API_KEY=
# Serverless index region/cloud (e.g. us-east-1 / aws)
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
# Two separate indexes per CLAUDE.md — do not collapse into one.
PINECONE_INDEX_CONFIGS=workflowgpt-configs
PINECONE_INDEX_PROSE=workflowgpt-prose

# --- Embeddings ---
# Local, free, no API key: fastembed (ONNX runtime) runs inside the backend itself.
# Never OpenAI — zero-cost constraint for this project, see CLAUDE.md.
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- LLM for generation (Answer Generator + Fix Agent) ---
# OpenRouter, free-tier models only (":free" suffix) — never OpenAI directly,
# never a paid OpenRouter model. Sign up free at https://openrouter.ai
# Check current free models: curl https://openrouter.ai/api/v1/models | grep ':free'
LLM_PROVIDER=openrouter
LLM_MODEL=google/gemma-4-26b-a4b-it:free
OPENROUTER_API_KEY=

# --- GitHub (Search Code API top-up pulls in Phase 1c, rate-limit headroom) ---
GITHUB_TOKEN=

# --- Stack Exchange API (Phase 1e) ---
# Optional but recommended: raises the anonymous quota from 300/day to 10000/day.
# Register an app key at https://stackapps.com/apps/oauth/register
STACK_EXCHANGE_KEY=

# --- Backend (FastAPI) ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# --- Frontend (Next.js) ---
# Base URL the frontend uses to reach the FastAPI backend.
NEXT_PUBLIC_API_URL=http://localhost:8000
